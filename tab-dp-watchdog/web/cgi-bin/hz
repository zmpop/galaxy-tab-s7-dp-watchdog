#!/system/bin/sh
# CGI: set the external display refresh rate (POST mode=60|120|auto).
# Legacy body "lock=1|0" is still accepted (lock=1 -> 60, lock=0 -> auto).
# 1. writes HZ_MODE into the config (daemon hot-reloads it, idempotent here)
# 2. applies the corresponding DP pixel clock cap in the kernel:
#      60 -> PCLK_CAP_KHZ (default 300000)
#     120 -> PCLK_120_KHZ (default 560000)
#    auto -> kernel default limit restored (no filtering)
# 3. if the DP link is up, re-enumerates it once so the framework re-picks
#    a mode within the new limit (external screen blacks out ~3s - normal)
echo "Content-Type: application/json"
echo ""

LOGDIR=/data/adb/tpdp
CFG=$LOGDIR/config
PCLK_NODE=/sys/kernel/debug/drm_dp/max_pclk_khz
HPD_NODE=/sys/kernel/debug/drm_dp/hpd
DPDEBUG_NODE=/sys/kernel/debug/drm_dp/dp_debug
EXTCON_STATE=/sys/class/extcon/extcon0/state
HZ_MODE=60; PCLK_CAP_KHZ=300000; PCLK_120_KHZ=560000
[ -f "$CFG" ] && . "$CFG" 2>/dev/null
: ${PCLK_CAP_KHZ:=300000}
: ${PCLK_120_KHZ:=560000}
mkdir -p "$LOGDIR"

body=""
if [ "$REQUEST_METHOD" = "POST" ] && [ -n "$CONTENT_LENGTH" ]; then
    body=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)
fi

mode=$(printf '%s' "$body" | sed -n 's/.*mode=\([0-9a-zA-Z]*\).*/\1/p' | head -n 1)
if [ -z "$mode" ]; then
    # legacy v1.3.2 clients sent lock=1|0
    lock=$(printf '%s' "$body" | sed -n 's/.*lock=\([01]\).*/\1/p' | head -n 1)
    case "$lock" in
        1) mode=60 ;;
        0) mode=auto ;;
    esac
fi
case "$mode" in
    60|120|auto) ;;
    *)
        printf '{"ok":false,"msg":"参数无效：需要 mode=60 / mode=120 / mode=auto"}'
        exit 0
        ;;
esac

[ -e "$HPD_NODE" ] || mount -t debugfs none /sys/kernel/debug 2>/dev/null
if [ ! -e "$PCLK_NODE" ]; then
    printf '{"ok":false,"msg":"内核不支持像素时钟限制节点，无法切换"}'
    exit 0
fi

# remember the kernel default limit before the first cap
if [ ! -s "$LOGDIR/pclk_org" ]; then
    org=$(sed -n 's/.*org: \([0-9]\{1,\}\).*/\1/p' "$PCLK_NODE" 2>/dev/null)
    [ -n "$org" ] && [ "$org" -gt 0 ] 2>/dev/null && echo "$org" > "$LOGDIR/pclk_org"
fi

dp_up=0
grep -q 'DP=1' "$EXTCON_STATE" 2>/dev/null && dp_up=1

hz_before=$(sed -n 's/^[[:space:]]*resolution=//p' "$DPDEBUG_NODE" 2>/dev/null | head -n 1)

# 1) kernel cap for the chosen mode
case "$mode" in
    60)  cap=$PCLK_CAP_KHZ ;;
    120) cap=$PCLK_120_KHZ ;;
    auto)
        cap=$(cat "$LOGDIR/pclk_org" 2>/dev/null)
        [ -n "$cap" ] || cap=675000
        ;;
esac
echo "$cap" > "$PCLK_NODE" 2>/dev/null || {
    printf '{"ok":false,"msg":"写入像素时钟上限失败"}'
    exit 0
}

# 2) persist config (keep other keys, replace HZ_MODE, drop legacy LOCK60)
touch "$CFG"
sed -i '/^HZ_MODE=/d;/^LOCK60=/d' "$CFG" 2>/dev/null
printf 'HZ_MODE=%s\n' "$mode" >> "$CFG"

# 3) re-enumerate so the framework re-picks a mode within the new limit
note=""
if [ "$dp_up" = "1" ]; then
    echo 0 > "$HPD_NODE" 2>/dev/null
    sleep 2
    echo 1 > "$HPD_NODE" 2>/dev/null
    i=0
    while [ $i -lt 12 ]; do
        grep -q 'DP=1' "$EXTCON_STATE" 2>/dev/null && break
        sleep 1
        i=$((i + 1))
    done
else
    note="（DP 链路当前未连接，将在下次连接时生效）"
fi

hz_after=$(sed -n 's/^[[:space:]]*resolution=//p' "$DPDEBUG_NODE" 2>/dev/null | head -n 1)
[ -n "$hz_after" ] || hz_after=unknown

echo "$(date '+%Y-%m-%d %H:%M:%S') web: hz mode -> $mode (${hz_before:-unknown} -> $hz_after)" >> "$LOGDIR/log"

case "$mode" in
    60)   msg="已选择 60Hz，当前模式 ${hz_after}${note}" ;;
    120)  msg="已选择 120Hz，当前模式 ${hz_after}${note}" ;;
    auto) msg="已恢复自动模式（不限速），当前模式 ${hz_after}${note}" ;;
esac
printf '{"ok":true,"mode":"%s","hz":"%s","msg":"%s"}' "$mode" "$hz_after" "$msg"

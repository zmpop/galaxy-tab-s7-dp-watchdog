#!/system/bin/sh
# CGI: current watchdog status as JSON.
echo "Content-Type: application/json"
echo ""

LOGDIR=/data/adb/tpdp
CFG=$LOGDIR/config
TP_VID=04f3; TP_PID=8512; WEB_TIMEOUT=300
[ -f "$CFG" ] && . "$CFG" 2>/dev/null

dp=0
grep -q 'DP=1' /sys/class/extcon/extcon0/state 2>/dev/null && dp=1

tp=0
for d in /sys/bus/usb/devices/*; do
    case "${d##*/}" in *:*) continue ;; esac
    [ -f "$d/idVendor" ] || continue
    if [ "$(cat "$d/idVendor" 2>/dev/null)" = "$TP_VID" ] && \
       [ "$(cat "$d/idProduct" 2>/dev/null)" = "$TP_PID" ]; then
        tp=1; break
    fi
done

daemon=0
pgrep -f 'modules/tab_dp_watchdog/service.sh' >/dev/null 2>&1 && daemon=1

# screen gated video output (v1.3.0)
vid=0
pgrep -f 'modules/tab_dp_watchdog/screenvid.sh' >/dev/null 2>&1 && vid=1
vstate=$(cat "$LOGDIR/video.state" 2>/dev/null)
[ -n "$vstate" ] || vstate=on
vswitch=1
[ -f "$LOGDIR/video.disabled" ] && vswitch=0
[ "$VIDEO_SWITCH" = "0" ] && vswitch=0
scr=unknown
w=$(dumpsys power 2>/dev/null | sed -n 's/.*mWakefulness=\([A-Za-z]*\).*/\1/p' | head -n 1)
case "$w" in
    Awake)         scr=on ;;
    Asleep|Dozing) scr=off ;;
esac

remain=-1
if [ -f "$LOGDIR/web.start" ]; then
    st=$(cat "$LOGDIR/web.start" 2>/dev/null)
    now=$(date +%s)
    [ -n "$st" ] && remain=$(( st + WEB_TIMEOUT - now ))
fi
[ "$remain" -gt 0 ] 2>/dev/null || remain=0

cfg=0
[ -f "$CFG" ] && cfg=1

printf '{"vid":"%s","pid":"%s","dp":%d,"tp_online":%d,"daemon":%d,"config":%d,"remain":%d,"screen":"%s","video":"%s","video_daemon":%d,"video_switch":%d}\n' \
    "$TP_VID" "$TP_PID" "$dp" "$tp" "$daemon" "$cfg" "$remain" "$scr" "$vstate" "$vid" "$vswitch"
